# Four DGX Sparks (TP=4) on Jay's Zig engine (engine/zig, docs/ZIG-TP4-PLAN.md): config/prod-zig.env.example's
# measured serving profile with this fork's four-Spark settings (config/tp4.env.example). NOT QUALIFIED: no GPU run
# at TP=4 yet. Copy to config/tp4-zig.env on EACH node, fill in every <placeholder>, then on each node:
#   CONFIG=config/tp4-zig.env scripts/run-zig.sh <rank> --dry-run    (ranks 1, 2, 3 first, then 0)
#
# Differences from prod-zig.env.example (TP=2, q28-v2), and why:
# - TP_WORLD=4: run-zig.sh starts rank 0 (`tensorfold-dsv41 serve`) or a follower (`tf-dsv41-m1 follow`) for 1..3.
# - MODEL_DIR: the 2.9 bpw pack the Python TP=4 service serves (like-for-like). Its experts are one width a
#   projection (the loader's .stack layout); q28-v2 is not loadable by the Python TP=4 engine.
# - TF_COMM_BACKEND=roce: the Zig RoCE all-gather at four ranks (fabric/tp/roce.zig, N-way since zig-tp4; the
#   Python 0003 wiring: one queue pair a HCA and peer, HCAs paired by subnet, posts to the next rank first). Shards up
#   to GLM53_TF_ROCE_MAX_KB go over RoCE, larger ones and exchanges over NCCL. A failed setup or load-time probe on
#   any rank puts every rank on NCCL (TF_TP_ROCE_FALLBACK=nccl; =error refuses to start instead). Check it first:
#   scripts/zig-tp4-roce-check.sh. To run on NCCL alone: TF_COMM_BACKEND=nccl.
#   FIRST WINDOW: override to TF_COMM_BACKEND=nccl (paired against Python on NCCL), so the first
#   measurement isolates the engine. RoCE boots only after scripts/zig-tp4-roce-check.sh passes.
# - TF_DSV41_CONTEXT=420096: 420K a slot (tp4.env's CONTEXT=420000) rounded up to whole 256-token pages (aot-needs
#   refuses a context that is not); TF_DSV41_POOL_TOKENS=1201152 as live (4,692 pages, 1,173 a rank's residue).
# - TF_DSV41_IMAGES=native + TF_DSV41_BIAS_VL: image input as live (prod-zig serves a placeholder).
# - TF_DSV41_PF_OVERLAP stays unset: TP=2 only (prod_knobs.zig refuses it at world 4).
# - TF_DSV41_VLLM_METRICS=1: the vllm:* series of patches/0003 on /metrics (fleet dashboards); /v1/model_info is always on.
# - TF_DSV41_PREFILL_PIPE (docs/ZIG-PREFILL-PIPE.md): the port of Python's pipelined prompt reading, OFF here until a
#   window qualifies it. To try it, set it to 1024 (tp4.env's value) in the copied config, and regenerate the AOT fill
#   with it set (its stage programs add world-1 Triton variants). +~23 GiB a rank of stage copies; sessions get their own
#   tag. Optional: TF_DSV41_PIPE_TRACE=1 (round timings), TF_DSV41_PREFILL_PIPE_BOUNDS, TF_DSV41_PIPE_ROWS=4096.
# - No equivalents yet (docs/ZIG-TP4-PLAN.md): INDEX_SPLIT, PREFILL_OVERLAP, EXPERT_ROTATE, DRAFT_HEAD=q4, logprobs (0006).
TP_WORLD=4
ZIG_NAME=zigtp4                               # containers zigtp4-r0 .. zigtp4-r3 (never the live dsv41-tf4-*)
ZIG_COMMIT="<engine-source-commit>"           # the zig-tp4 commit the image was built from (image label)
IMAGE="dsv41-tensorfold:zigtp4-<shortsha>"
TF_TP_MASTER="<head-link-ip>"                 # rank 0 on the link: tp4.env's HEAD_IP
TF_TP_PORT=29571                              # not the live Python ports (NCCL 29500 + plan/fate ports)
TF_COMM_BACKEND=roce                          # nccl: every exchange over NCCL (the fallback, also automatic on failure)
TF_TP_ROCE_FALLBACK=nccl
TF_TP_ROCE_HCA="rocep1s0f1,roceP2p1s0f1"      # both CX7 functions, as NCCL_IB_HCA (unset: every active port with an IPv4 RoCE v2 GID)
NCCL_SOCKET_IFNAME="<link netdev>"            # tp4.env's NCCL_SOCKET_IFNAME
NCCL_IB_HCA="rocep1s0f1,roceP2p1s0f1"         # tp4.env's: both CX7 functions
MODEL_DIR="<path>/DeepSeek-V4.1-Flash-EXL3-2.9bpw"   # tp4.env's MODEL, same path on every node, read-only
ENGRAM_DIR="<path>/dsv41-engram-w4"           # tp4.env's ENGRAM: engram-l{1,14}-r{rank}of4.bin, read-only
ASSETS_DIR="<path>/zigtp4-assets/rank-<rank>" # per rank: rope.bin, engram-host.bin, aot/ (aot-needs with TF_TP_RANK)
PREPARED_DIR="<path>/zigtp4-prepared"         # Zig's own prepared layer images (not Python's), written by the first boot
STATE_DIR="<path>/zigtp4-state"               # request log, sessions (NVMe tier), calibration
CACHE_DIR="<path>/zigtp4-cache"               # /cache: pfdense-table.json, the image routing bias
HOST=127.0.0.1                                # tp4.env's: put a proxy / auth in front for the LAN
PORT=8000                                     # the window replaces the live server on :8000 (Depths' swap)
MALLOC_ARENA_MAX=4
TF_DSV41_VLLM_METRICS=1
TF_DSV41_CONTEXT=420096
TF_DSV41_ASSETS=/assets

# config/prod-zig.env.example's engine values (the measured TP=2 serving set), unchanged
TF_DSV41_R1=1
TF_DSV41_DRAFTS=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_GRAPHS=1
TF_DSV41_SAMPLING=1
TF_DSV41_SLOTS=4
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_POOL_TOKENS=1201152
TF_DSV41_INDEX_KV=fp8
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_ENGRAM_DIR=/engram
TF_DSV41_PREPARED=/prepared
TF_DSV41_PREPARED_WRITE=1
TF_DSV41_PLAN_TIMEOUT=1800
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_SESSION_DISK=/sessions
TF_DSV41_SESSION_DISK_GIB=128
TF_DSV41_SESSION_DISK_MIN=1024
TF_DSV41_FLOOR_GIB=5
TF_DSV41_FLOOR_HARD_GIB=4
TF_DSV41_REQUEST_LOG=/state/requests.jsonl
TF_DSV41_DISCONNECT=1
TF_DSV41_DRAIN_S=20
TF_DSV41_SSE_KEEPALIVE_S=15
TF_DSV41_THINKING=1
TF_DSV41_DEFAULT_EFFORT=high
TF_DSV41_SCHEMA_PROMPT=1
TF_DSV41_IMAGES=native
TF_DSV41_BIAS_VL=/cache/dsv41-bias-vl
TF_DSV41_VISION_PREP_MB=64
# video_url parts (base64 data URLs only) become timestamped PNG frames before the vision tower; the frames count against
# TF_DSV41_VISION_MAX_IMAGES (8), so raise that first to take more than 8 images and frames in one request.
# The decoder is a one-shot python3 child with PyAV + Pillow (the image's venv); defaults shown:
# TF_VIDEO_MAX_FRAMES=8        frames a clip yields (1-64); longer clips are sampled evenly
# TF_VIDEO_FPS=2               sampling rate for short clips (0.1-30)
# TF_VIDEO_MAX_DURATION=300    seconds; longer clips are refused (1-3600)
# TF_VIDEO_MAX_SIDE=768        a frame's longer side in pixels (32-2048)
# TF_VIDEO_MAX_OUTPUT_BYTES=16777216  all frames together
# TF_VIDEO_MAX_INPUT_BYTES=33554432   one decoded clip (the HTTP body cap is 32 MiB)
# TF_VIDEO_TIMEOUT=30          seconds the decoder child may run
# Longer-clip profile deployed and verified 2026-10-26 (6-minute real MP4 => "red, blue"):
TF_VIDEO_MAX_DURATION=900
TF_VIDEO_MAX_FRAMES=32
TF_DSV41_VISION_MAX_IMAGES=32
TF_VIDEO_TIMEOUT=120
TF_VIDEO_MAX_OUTPUT_BYTES=67108864
# The decoded-input and HTTP body caps intentionally remain 32 MiB; larger uploads need a separate code change.
GLM53_TF_ROCE_MAX_KB=1024
TF_DSV41_INDEX_BUDGET_MIB=64
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_SPEC_DRAFT=1
TF_DSV41_DRAFT_GRAPHS=1
TF_DSV41_ROWS_CAP=64
TF_DSV41_GRAMMAR=1
TF_DSV41_TOOL_GRAMMAR=0
TF_DSV41_PF_DENSE=fused
TF_DSV41_PF_DENSE_TABLE=/cache/pfdense-table.json
TF_DSV41_PLAN_LINK=rdma
TF_DSV41_PLAN_PIN=auto
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_DEPTH_JOINT=0
TF_DSV41_ENGRAM_GATE=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_MHC_DEFER=1
GLM53_TF_ROCE_FAST=1
TF_DSV41_GREEDY_GPU=1
TF_DSV41_PREFILL=replay
TF_DSV41_GM_V2=1
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_TAIL_JOIN=1
TF_DSV41_DRAFT_TIMED=1
TF_DSV41_CODE_ACCEPT=0
TF_DSV41_ROUTER_GROUP_ROT=1
TF_DSV41_MHC_PFDEC=17
TF_DSV41_DRAFT_BATCH_PROJ=1
TF_DSV41_DRAFT_CHAIN=1
TF_DSV41_DRAFT_OVERLAP=1
TF_DSV41_ROUND_GRAPH=1
TF_DSV41_KV_NORM_STORE=1
TF_DSV41_LOOKUP_PLAN=1
TF_DSV41_JOIN_DRAFTS=1
TF_DSV41_PIECE_RUNS=1
TF_DSV41_REPLAY_RUNS=1
TF_DSV41_PF_4K=1
TF_DSV41_PF_4K_MEMORY_OK=1
TF_DSV41_PREFILL_CHUNK=4096
TF_DSV41_PREFILL_ROWS=4096
TF_DSV41_PF_WS_FLOOR_GIB=3.5
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_DRAFT_CAPTURE=1
TF_DSV41_MHC_DEFER_AT=exchange
TF_DSV41_LIN2=1
TF_DSV41_GRAPH_FLOOR=hold
TF_DSV41_PF_WS_SHARE=1
TF_DSV41_INDEX_BOUND=1
# a world-4 table is measured on the first boot (the key has the world; TP=2 tables never match)
TF_DSV41_CALIB=zig
TF_DSV41_CALIB_DIR=/state/calib-zig
TF_DSV41_LOOKUP=1
TF_DSV41_ENGRAM_PREFETCH=1
