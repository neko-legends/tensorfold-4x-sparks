+/// The text vocabulary within the grammar ABI range: text_config, llm_config, then root.
+pub fn vocabSize(cfg: Value) ?u32 {
+    for ([_]?Value{ cfg.get("text_config"), cfg.get("llm_config"), cfg }) |part| if (part) |p| {
